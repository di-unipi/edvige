<!DOCTYPE html>
<html class="h-100" lang="en" data-bs-theme="dark">
  <head>
    <title>Edvige</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Edvige">
    <meta name="author" content="R. Massidda">
    <link href="favicon.svg" rel="icon">
    <link href="vendor/bootstrap/bootstrap.min.css" rel="stylesheet">
    <link href="vendor/fonts/fonts.css" rel="stylesheet">
    <link href="css/style.css" rel="stylesheet">
    <script src="js/script.js" defer></script>
    <script src="js/autorefresh.js" defer></script>
  </head>
  <body class="d-flex flex-column h-100">
    <main class="flex-shrink-0">
      <div class="container-fluid mt-4">
        <div class="row g-4">
          <div class="col-4 h-100" id="left">
            <div class="card mb-3 special-card welcome">
              <div class="card-body">
                <div class="row g-0">
                  <div class="col-md-8 welcome-text">
                    <p class="kicker">Computer Science · Unipi</p>
                    <h1 class="welcome-title">Edvige <span class="owl" aria-hidden="true">🦉</span></h1>
                    <p class="welcome-lead">Seminars, talks and events at the Department, straight from our calendar.</p>
                    <p class="welcome-contact">Something wrong? Write to <a href="mailto:comunicazione@di.unipi.it">comunicazione@di.unipi.it</a></p>
                  </div>
                  <div class="col-md-4">
                    <figure class="qr">
                      <img src="assets/qr.png" alt="QR code linking to the Department calendar">
                      <figcaption>Scan for the calendar</figcaption>
                    </figure>
                  </div>
                </div>
              </div>
            </div>
            {%- for event in events %}
            <div class="card mb-3 event{% if event.live %} live-event{% endif %}{% if event.past %} past-event{% endif %} invisible">
              <div class="row g-0">
                <div class="col-md-3">
                  <div class="info">
                    <p class="date"><span class="weekday">{{ event.weekday }}</span><span class="day">{{ event.day }}</span><span class="month">{{ event.month }}</span></p>
                    <p class="time">{{ event.when }}</p>
                    {%- if event.live %}
                    <p class="status status-live">Live</p>
                    {%- endif %}
                    {%- if event.past %}
                    <p class="status status-ended">Ended</p>
                    {%- endif %}
                  </div>
                </div>
                <div class="col-md-9">
                  <div class="card-body">
                    {%- if event.hashtags %}
                    <p class="kicker hashtags"><span class="hashtag">{{ event.hashtags | join(" / ") }}</span></p>
                    {%- endif %}
                    <h3 class="card-title">{{ event.title }}</h3>
                    {%- if event.subtitle %}
                    <p class="card-subtitle">{{ event.subtitle }}</p>
                    {%- endif %}
                    {%- if event.location %}
                    <p class="location">{{ event.location }}</p>
                    {%- endif %}
                    {%- if event.abstract %}
                    <p class="card-text abstract">
                      {%- for line in event.abstract %}{{ line }}{% if not loop.last %}<br>
                      {% endif %}{% endfor -%}
                    </p>
                    {%- endif %}
                  </div>
                </div>
              </div>
            </div>
            {%- endfor %}
          </div>
          <div class="col-4 h-100" id="center"></div>
          <div class="col-4 h-100" id="right">
            {%- if locandina %}
            <div class="card mb-3 special-card poster">
              <img src="assets/locandina.png" alt="Poster of an upcoming event">
            </div>
            {%- endif %}
          </div>
        </div>
      </div>
    </main>
    <footer class="footer mt-auto">
      <div class="container-fluid">
        <div class="row">
          <div class="col-6">
            <p id="last-update" data-updated="{{ updated.isoformat(timespec="seconds") }}">Last update: {{ updated.strftime("%d/%m/%Y") }} at {{ updated.strftime("%H:%M") }}</p>
          </div>
          <div class="col-6 text-end">
            <p>Made with ❤️ by the Department’s Communication Team</p>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
