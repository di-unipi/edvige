<!DOCTYPE html>
<html class="h-100" lang="en" data-bs-theme="dark">
  <head>
    <title>Edvige</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Edvige">
    <meta name="author" content="R. Massidda">
    <link href="/favicon.svg" rel="icon">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.3.0/font/bootstrap-icons.css" rel="stylesheet">
    <link href="css/style.css" rel="stylesheet">
    <script src="js/script.js" defer></script>
    <script src="js/autorefresh.js" defer></script>
  </head>
  <body class="d-flex flex-column h-100">
    <main class="flex-shrink-0">
      <div class="container-fluid mt-4 ml-4 mr-4">
        <div class="row g-4">
          <div class="col-4 h-100" id="left">
            <div class="card mb-3 special-card">
              <div class="card-body">
                <div class="h4 card-title">Hey there! 🦉</div>
                <div class="row gx-5 mt-3">
                  <div class="col-md-8">
                    <p class="text-large"><strong>Edvige</strong>'s here to help you
                      keep track of the events you care about.
                    </p>
                    <p>
                      Something's not working?<br>
                      Drop us a line at
                      <a href="mailto:comunicazione@di.unipi.it">comunicazione@di.unipi.it</a>
                    </p>
                  </div>
                  <div class="col-md-4 text-center"><img class="rounded mt-0 mb-0" src="assets/qr.png" width="85%"></div>
                </div>
              </div>
            </div>
            {%- for event in events %}
            <div class="card mb-3{% if event.past %} past-event{% endif %} invisible">
              <div class="row g-0">
                <div class="col-md-3">
                  <div class="info">
                    <h3 class="day mb-0">{{ event.day }}</h3>
                    <h5 class="month mb-0">{{ event.month }}</h5>
                    <p>{{ event.start_time }}-{{ event.end_time }}</p>
                    {%- if event.live %}
                    <h4><span class="badge bg-danger"><i class="live-icon bi bi-broadcast"></i><span> LIVE</span></span></h4>
                    {%- endif %}
                    {%- if event.past %}
                    <h5><span class="badge bg-warning"><i class="bi bi-hourglass-bottom"></i> Ended!</span></h5>
                    {%- endif %}
                    {%- if event.hashtags %}
                    <div class="hashtags mt-3 pt-3 text-muted small"><span class="hashtag">{{ event.hashtags | join(", ") }}</span></div>
                    {%- endif %}
                  </div>
                </div>
                <div class="col-md-9">
                  <div class="card-body">
                    <h3 class="card-title">{{ event.title }}</h3>
                    {%- if event.subtitle %}
                    <h5 class="card-subtitle text-body-secondary">{{ event.subtitle }}</h5>
                    {%- endif %}
                    {%- if event.location %}
                    <p class="i text-body-secondary">{{ event.location }}</p>
                    {%- endif %}
                    {%- if event.abstract %}
                    <p class="mt-1 card-text abstract">
                      {%- for line in event.abstract %}{{ line }}{% if not loop.last %}<br>
                      {% endif %}{% endfor -%}
                    </p>
                    {%- endif %}
                  </div>
                </div>
              </div>
            </div>
            {%- endfor %}
          </div>
          <div class="col-4 h-100" id="center"></div>
          <div class="col-4 h-100" id="right">
            {%- if locandina %}
            <div class="card mb-3 special-card">
              <div class="card-body"><img class="rounded mt-0 mb-0" src="assets/locandina.png" width="100%"></div>
            </div>
            {%- endif %}
          </div>
        </div>
      </div>
    </main>
    <footer class="footer mt-auto py-2 bg-body-tertiary mb-0">
      <div class="container-fluid">
        <div class="row text-body-secondary">
          <div class="col-6">
            <p class="mb-0">Last update: {{ updated.strftime("%d/%m/%Y") }} at {{ updated.strftime("%H:%M") }}</p>
          </div>
          <div class="col-6 text-end">
            <p class="mb-0">Made with ❤️ by the Department's Communication Team</p>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
